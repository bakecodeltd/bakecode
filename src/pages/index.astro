---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import ProductFeature from '../components/ProductFeature.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { products } from '../data/products';
import { expertise } from '../data/site';
---

<BaseLayout
  title="Bake Code"
  description="Bake Code is an independent UK software studio building useful digital products and engineering modern applications."
>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow"><span>Independent software studio</span> / UK</p>
      <h1>
        <span class="hero-line">Engineering</span>
        <span class="hero-line"><em>software.</em></span>
        <span class="hero-line hero-line--indent">Building products.</span>
      </h1>
      <div class="hero-bottom">
        <p>Bake Code is an independent software studio building useful digital products and engineering modern applications.</p>
        <div class="hero-actions">
          <a class="button" href="/products">Explore our products <ArrowIcon /></a>
          <a class="button button--ghost" href="/services">What we do</a>
        </div>
      </div>
    </div>

    <div class="hero-workbench" aria-hidden="true">
      <div class="bench-grid"></div>
      <div class="bench-label">BUILD / 01</div>
      <div class="code-panel">
        <div class="panel-bar"><i></i><i></i><i></i><span>product.ts</span></div>
        <div class="code-lines">
          <p><b>const</b> idea = <em>{`{`}</em></p>
          <p>&nbsp;&nbsp;useful: <span>true</span>,</p>
          <p>&nbsp;&nbsp;simple: <span>true</span>,</p>
          <p>&nbsp;&nbsp;crafted: <span>true</span></p>
          <p><em>{`}`}</em>;</p>
        </div>
      </div>
      <div class="module module-a"><span>01</span><b>&lt;/&gt;</b></div>
      <div class="module module-b"><span>02</span><b>API</b></div>
      <div class="module module-c"><span>03</span><b>UI</b></div>
      <div class="output-card"><span>OUTPUT</span><b>Useful<br />software.</b><i>↗</i></div>
      <div class="bench-caption">Raw idea → working product</div>
    </div>

    <p class="hero-index">BC / 2026</p>
  </section>

  <section class="doing section">
    <div class="shell">
      <div class="doing-heading reveal">
        <p class="eyebrow"><span>What we do</span> / Two sides, one studio</p>
        <h2 class="display-title">Built for others.<br /><em>Built from within.</em></h2>
      </div>
      <div class="doing-list">
        <a class="doing-row reveal" href="/services">
          <span class="doing-number">01</span>
          <h3>Software<br />Engineering</h3>
          <p>Designing and developing reliable applications, from backend systems to polished web experiences.</p>
          <span class="doing-arrow"><ArrowIcon /></span>
        </a>
        <a class="doing-row reveal" href="/products" data-delay="1">
          <span class="doing-number">02</span>
          <h3>Independent<br />Products</h3>
          <p>Creating original digital tools, applications and interactive experiences that solve practical problems.</p>
          <span class="doing-arrow"><ArrowIcon /></span>
        </a>
      </div>
    </div>
  </section>

  <section class="made-section">
    <div class="shell made-heading reveal">
      <p class="eyebrow"><span>Selected products</span> / Made at Bake Code</p>
      <h2 class="display-title">Independent products,<br /><em>thoughtfully built.</em></h2>
      <a class="text-link" href="/products">See all products <ArrowIcon /></a>
    </div>
    <div class="shell product-stack">
      {products.map((product, index) => (
        <ProductFeature
          product={product}
          number={String(index + 1).padStart(2, '0')}
          reverse={index === 1}
          compact
        />
      ))}
    </div>
  </section>

  <section class="philosophy section-dark">
    <div class="shell philosophy-grid">
      <p class="eyebrow light"><span>Our philosophy</span> / The working standard</p>
      <div class="statement reveal">
        <p>Thoughtfully engineered.</p>
        <p><em>Independently built.</em></p>
      </div>
      <p class="philosophy-copy reveal" data-delay="1">
        We believe the best software balances technical excellence with simplicity, creativity and a clear purpose.
      </p>
      <div class="philosophy-symbol" aria-hidden="true"><span>{`{`}</span><i></i><span>{`}`}</span></div>
    </div>
  </section>

  <section class="expertise section">
    <div class="shell expertise-heading reveal">
      <p class="eyebrow"><span>Technology & expertise</span> / Working materials</p>
      <h2>Tools are chosen for the work,<br />not the other way around.</h2>
      <p>Deep technical capability across the stack, applied with practical judgement and a bias towards clear, maintainable systems.</p>
    </div>
    <div class="shell expertise-index reveal" data-delay="1">
      {expertise.map((item, index) => (
        <div class="expertise-item"><span>{String(index + 1).padStart(2, '0')}</span><strong>{item}</strong><i aria-hidden="true">↗</i></div>
      ))}
    </div>
  </section>

  <ContactCTA />
</BaseLayout>

<style>
  .hero { position: relative; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(22rem, 0.72fr); gap: clamp(2rem, 5vw, 6rem); align-items: center; min-height: calc(100svh - var(--header-height)); padding-block: clamp(4rem, 8vh, 7rem); }
  .hero-copy { position: relative; z-index: 2; }
  .hero-eyebrow { margin-bottom: clamp(2.5rem, 6vh, 5rem); }
  h1 { margin: 0; font-family: var(--font-display); font-size: clamp(4rem, 8.2vw, 9.3rem); font-weight: 570; letter-spacing: -0.085em; line-height: 0.79; }
  .hero-line { display: block; }
  .hero-line em { color: var(--orange); font-style: normal; }
  .hero-line--indent { margin-left: clamp(1rem, 5vw, 6rem); font-size: 0.83em; white-space: nowrap; }
  .hero-bottom { display: grid; grid-template-columns: minmax(16rem, 1fr) auto; gap: 2rem; align-items: end; margin-top: clamp(3rem, 7vh, 5.5rem); }
  .hero-bottom > p { max-width: 39rem; margin: 0; color: var(--muted); font-size: clamp(1rem, 1.3vw, 1.15rem); line-height: 1.7; }
  .hero-actions { display: flex; gap: 0.7rem; }
  .hero-index { position: absolute; right: var(--gutter); bottom: 1.25rem; margin: 0; color: var(--muted); font-size: 0.58rem; font-weight: 700; letter-spacing: 0.12em; }

  .hero-workbench { position: relative; aspect-ratio: 0.82; max-height: 44rem; overflow: hidden; border: 1px solid var(--ink); background: var(--ink-soft); color: var(--cream); box-shadow: 1.1rem 1.1rem 0 var(--orange); transform: rotate(1.2deg); }
  .bench-grid { position: absolute; inset: 0; background-image: linear-gradient(rgb(247 245 240 / 0.08) 1px, transparent 1px), linear-gradient(90deg, rgb(247 245 240 / 0.08) 1px, transparent 1px); background-size: 12.5% 10%; }
  .bench-label { position: absolute; top: 1rem; left: 1rem; color: var(--stone-light); font-size: 0.55rem; font-weight: 750; letter-spacing: 0.14em; }
  .code-panel { position: absolute; top: 10%; right: 7%; left: 7%; height: 39%; border: 1px solid rgb(247 245 240 / 0.24); background: #1b1d20; box-shadow: 0.75rem 0.75rem 0 rgb(0 0 0 / 0.25); transform: rotate(-2deg); }
  .panel-bar { display: flex; align-items: center; gap: 0.35rem; height: 2rem; padding-inline: 0.7rem; border-bottom: 1px solid rgb(247 245 240 / 0.16); }
  .panel-bar i { width: 0.38rem; aspect-ratio: 1; border-radius: 50%; background: var(--orange); }
  .panel-bar i:nth-child(2) { background: var(--yellow); }
  .panel-bar i:nth-child(3) { background: #75c99e; }
  .panel-bar span { margin-left: auto; color: var(--stone-light); font-family: monospace; font-size: 0.55rem; }
  .code-lines { padding: 1rem 1.2rem; color: #e6e0d6; font-family: 'SFMono-Regular', Consolas, monospace; font-size: clamp(0.62rem, 1vw, 0.9rem); line-height: 1.35; }
  .code-lines p { margin: 0 0 0.32rem; }
  .code-lines b { color: #caa8ff; font-weight: 500; }
  .code-lines em { color: var(--orange); font-style: normal; }
  .code-lines span { color: #75d7b0; }
  .module { position: absolute; z-index: 2; display: flex; flex-direction: column; justify-content: space-between; width: 21%; aspect-ratio: 1; padding: 0.7rem; border: 1px solid var(--ink); color: var(--ink); box-shadow: 0.35rem 0.35rem 0 rgb(23 25 28 / 0.5); transition: transform 400ms var(--ease); }
  .module span { font-size: 0.5rem; font-weight: 800; }
  .module b { font-family: var(--font-display); font-size: clamp(0.85rem, 1.5vw, 1.3rem); align-self: flex-end; }
  .module-a { top: 53%; left: 8%; background: var(--yellow); transform: rotate(-7deg); }
  .module-b { top: 56%; left: 32%; background: #a5d7c3; transform: rotate(4deg); }
  .module-c { top: 51%; left: 56%; background: #d2b8df; transform: rotate(-2deg); }
  .hero-workbench:hover .module-a { transform: translateY(-0.4rem) rotate(-10deg); }
  .hero-workbench:hover .module-b { transform: translateY(0.25rem) rotate(7deg); }
  .hero-workbench:hover .module-c { transform: translateY(-0.3rem) rotate(-5deg); }
  .output-card { position: absolute; z-index: 3; right: 7%; bottom: 7%; left: 14%; display: flex; height: 22%; flex-direction: column; padding: 1rem; border: 1px solid var(--ink); background: var(--orange); color: var(--ink); box-shadow: 0.6rem 0.6rem 0 #0e0f10; transform: rotate(2deg); }
  .output-card > span { font-size: 0.5rem; font-weight: 800; letter-spacing: 0.14em; }
  .output-card b { margin-top: auto; font-family: var(--font-display); font-size: clamp(1.2rem, 2.7vw, 2.6rem); font-weight: 650; letter-spacing: -0.055em; line-height: 0.86; }
  .output-card i { position: absolute; right: 1rem; bottom: 1rem; font-style: normal; }
  .bench-caption { position: absolute; right: 1rem; bottom: 1rem; writing-mode: vertical-rl; color: var(--stone-light); font-size: 0.45rem; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase; }

  .doing { border-top: 1px solid var(--line); }
  .doing-heading { display: grid; grid-template-columns: 0.6fr 1.4fr; gap: 3rem; align-items: start; margin-bottom: clamp(4rem, 9vw, 8rem); }
  .doing-heading h2 em, .made-heading h2 em { color: var(--orange); font-style: normal; }
  .doing-list { border-top: 1px solid var(--ink); }
  .doing-row { display: grid; grid-template-columns: 0.25fr 0.85fr 1fr auto; gap: clamp(1rem, 4vw, 4rem); align-items: center; padding-block: clamp(2rem, 4vw, 3.6rem); border-bottom: 1px solid var(--line); color: var(--ink); transition: padding 280ms var(--ease), background 220ms ease; }
  .doing-row:hover { padding-inline: 1.3rem; background: var(--paper); }
  .doing-number { color: var(--orange); font-size: 0.66rem; font-weight: 750; letter-spacing: 0.1em; }
  .doing-row h3 { margin: 0; font-family: var(--font-display); font-size: clamp(1.7rem, 3.2vw, 3.4rem); font-weight: 570; letter-spacing: -0.055em; line-height: 0.95; }
  .doing-row p { max-width: 34rem; margin: 0; color: var(--muted); font-size: 0.9rem; line-height: 1.7; }
  .doing-arrow { display: grid; width: 3.25rem; aspect-ratio: 1; place-items: center; border: 1px solid var(--line); border-radius: 50%; font-size: 1.2rem; transition: background 180ms ease, transform 220ms var(--ease); }
  .doing-row:hover .doing-arrow { background: var(--orange); transform: rotate(-8deg); }

  .made-section { padding-block: clamp(5rem, 10vw, 10rem); background: var(--paper); }
  .made-heading { display: grid; grid-template-columns: 0.55fr 1.35fr auto; gap: 2rem; align-items: end; margin-bottom: clamp(4rem, 8vw, 7rem); }
  .made-heading h2 { font-size: clamp(3rem, 6.5vw, 7rem); }
  .product-stack { display: grid; gap: clamp(2.5rem, 6vw, 6rem); }

  .philosophy { overflow: hidden; padding-block: clamp(6rem, 12vw, 12rem); }
  .philosophy-grid { position: relative; }
  .statement { position: relative; z-index: 2; margin-top: clamp(5rem, 12vw, 10rem); font-family: var(--font-display); font-size: clamp(3.4rem, 9vw, 10rem); font-weight: 520; letter-spacing: -0.085em; line-height: 0.82; }
  .statement p { margin: 0; }
  .statement p:last-child { margin-left: clamp(1.5rem, 10vw, 11rem); }
  .statement em { color: var(--orange); font-style: normal; }
  .philosophy-copy { position: relative; z-index: 2; max-width: 36rem; margin: clamp(4rem, 8vw, 7rem) 0 0 auto; color: var(--stone-light); font-size: clamp(1.05rem, 1.7vw, 1.35rem); line-height: 1.65; }
  .philosophy-symbol { position: absolute; z-index: 1; top: 4rem; right: -4%; display: flex; align-items: center; gap: 1rem; color: rgb(247 245 240 / 0.05); font-family: var(--font-display); font-size: clamp(12rem, 34vw, 32rem); font-weight: 300; line-height: 0.7; transform: rotate(-8deg); }
  .philosophy-symbol i { width: 0.2em; aspect-ratio: 1; background: currentColor; }

  .expertise-heading { display: grid; grid-template-columns: 0.6fr 1.15fr 0.7fr; gap: clamp(2rem, 5vw, 6rem); align-items: start; margin-bottom: clamp(4rem, 7vw, 6rem); }
  .expertise-heading h2 { margin: 0; font-family: var(--font-display); font-size: clamp(2.4rem, 4.8vw, 5.2rem); font-weight: 560; letter-spacing: -0.065em; line-height: 0.98; }
  .expertise-heading > p:last-child { margin: 0; color: var(--muted); font-size: 0.92rem; line-height: 1.75; }
  .expertise-index { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--ink); }
  .expertise-item { display: grid; grid-template-columns: auto 1fr auto; gap: 1rem; align-items: center; min-height: 5.6rem; padding: 1rem 1.25rem; border-bottom: 1px solid var(--line); }
  .expertise-item:nth-child(odd) { border-right: 1px solid var(--line); }
  .expertise-item span { color: var(--orange); font-size: 0.58rem; font-weight: 800; }
  .expertise-item strong { font-family: var(--font-display); font-size: clamp(1.2rem, 2vw, 1.65rem); font-weight: 540; letter-spacing: -0.035em; }
  .expertise-item i { color: var(--stone); font-style: normal; }

  @media (max-width: 1100px) {
    .hero { grid-template-columns: 1fr; padding-top: 5rem; }
    .hero-copy { max-width: 64rem; }
    .hero-workbench { width: min(80%, 42rem); margin: 2rem 0 3rem auto; aspect-ratio: 1.05; }
    .doing-heading, .made-heading, .expertise-heading { grid-template-columns: 1fr; }
    .made-heading .text-link { justify-self: start; }
  }

  @media (max-width: 760px) {
    .hero { display: block; min-height: auto; }
    h1 { font-size: clamp(3.8rem, 18vw, 6.5rem); line-height: 0.84; }
    .hero-line--indent { margin-left: 0.5rem; white-space: normal; }
    .hero-bottom { grid-template-columns: 1fr; }
    .hero-actions { align-items: stretch; }
    .hero-actions .button { flex: 1; }
    .hero-workbench { width: calc(100% - 0.75rem); margin-top: 4rem; aspect-ratio: 0.85; }
    .doing-row { grid-template-columns: auto 1fr auto; }
    .doing-row p { grid-column: 2 / -1; }
    .doing-arrow { grid-column: 3; grid-row: 1; }
    .statement p:last-child { margin-top: 1rem; margin-left: 0; }
    .philosophy-copy { margin-left: 0; }
    .expertise-index { grid-template-columns: 1fr; }
    .expertise-item:nth-child(odd) { border-right: 0; }
  }

  @media (max-width: 460px) {
    .hero-actions { flex-direction: column; }
    .hero-workbench { min-height: 31rem; }
    .doing-row { gap: 1rem; }
    .doing-row h3 { font-size: 1.8rem; }
  }
</style>
