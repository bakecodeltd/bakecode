---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ProductFeature from '../components/ProductFeature.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { products } from '../data/products';
---

<BaseLayout
  title="Products"
  description="Explore independent digital products designed and built by Bake Code, from productivity software to interactive learning and browser games."
>
  <PageHero
    eyebrow="Products / Made here"
    title="Ideas made<br /><em>useful.</em>"
    intro="Independent products are not a side project at Bake Code. They are where practical problems, creative experiments and careful engineering become things people can actually use."
    index="01"
  />

  <section class="product-intro section-dark">
    <div class="shell product-intro__grid">
      <p class="eyebrow light"><span>The product shelf</span> / 03 and growing</p>
      <p class="product-intro__statement reveal">Small enough to obsess over the details. Ambitious enough to keep evolving.</p>
      <div class="product-intro__legend reveal" data-delay="1">
        <span><i class="live"></i> Live</span>
        <span><i></i> In development</span>
      </div>
    </div>
  </section>

  <section class="products-list">
    <div class="shell product-stack">
      {products.map((product, index) => (
        <ProductFeature
          product={product}
          number={String(index + 1).padStart(2, '0')}
          reverse={index % 2 === 1}
        />
      ))}
    </div>
  </section>

  <section class="product-note section">
    <div class="shell note-grid reveal">
      <p class="eyebrow"><span>Always making</span> / The next build</p>
      <h2>Products begin as questions.</h2>
      <div>
        <p>Could this task be clearer? Could practice feel more rewarding? Could a small game create a big moment of delight?</p>
        <p>Bake Code explores those questions by designing, building and operating original software — one useful release at a time.</p>
      </div>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>

<style>
  .product-intro { padding-block: clamp(4rem, 7vw, 7rem); }
  .product-intro__grid { display: grid; grid-template-columns: 0.5fr 1.2fr 0.45fr; gap: clamp(2rem, 6vw, 7rem); align-items: end; }
  .product-intro__statement { margin: 0; font-family: var(--font-display); font-size: clamp(2.2rem, 4.3vw, 4.8rem); font-weight: 520; letter-spacing: -0.06em; line-height: 1; }
  .product-intro__legend { display: flex; flex-direction: column; gap: 0.65rem; color: var(--stone-light); font-size: 0.67rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; }
  .product-intro__legend span { display: flex; align-items: center; gap: 0.55rem; }
  .product-intro__legend i { width: 0.45rem; aspect-ratio: 1; border-radius: 50%; background: var(--orange); }
  .product-intro__legend i.live { background: #69c394; }
  .products-list { padding-block: clamp(5rem, 10vw, 10rem); background: var(--paper); }
  .product-stack { display: grid; gap: clamp(3rem, 8vw, 8rem); }
  .note-grid { display: grid; grid-template-columns: 0.5fr 1.1fr 0.65fr; gap: clamp(2rem, 6vw, 7rem); align-items: start; }
  .note-grid h2 { margin: 0; font-family: var(--font-display); font-size: clamp(2.8rem, 5.5vw, 6rem); font-weight: 550; letter-spacing: -0.07em; line-height: 0.95; }
  .note-grid > div { color: var(--muted); font-size: 0.94rem; line-height: 1.8; }
  .note-grid > div p + p { margin-top: 1.5rem; }

  @media (max-width: 850px) {
    .product-intro__grid, .note-grid { grid-template-columns: 1fr; }
    .product-intro__legend { flex-direction: row; gap: 1.5rem; }
  }
</style>
