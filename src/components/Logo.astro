---
interface Props {
  compact?: boolean;
  inverted?: boolean;
}

const { compact = false, inverted = false } = Astro.props;
---

<span class:list={['brand', { compact, inverted }]}>
  <svg viewBox="150 165 720 675" aria-hidden="true">
    <g class="hat">
      <path d="M312 692C311.5 685 311 665 309 650C307 635 302.5 615.3 300 602C297.5 588.7 299.7 580.7 294 570C288.3 559.3 275.3 546 266 538C256.7 530 246.5 528.7 238 522C229.5 515.3 221 506 215 498C209 490 205.5 482.7 202 474C198.5 465.3 195.7 454.7 194 446C192.3 437.3 191.7 431.3 192 422C192.3 412.7 193 400.7 196 390C199 379.3 203.3 367.7 210 358C216.7 348.3 225.2 339.7 236 332C246.8 324.3 261 316 275 312C289 308 304.1 306.7 320 308C335.9 309.3 361.8 317.9 370.1 319.9A145 145 0 0 1 652.9 319.9C661.3 317.9 687.1 309.3 703 308C718.9 306.7 734 308 748 312C762 316 776.2 324.3 787 332C797.8 339.7 806.3 348.3 813 358C819.7 367.7 824 379.3 827 390C830 400.7 830.7 412.7 831 422C831.3 431.3 830.7 437.3 829 446C827.3 454.7 824.5 465.3 821 474C817.5 482.7 814 490 808 498C802 506 793.5 515.3 785 522C776.5 528.7 766.3 530 757 538C747.7 546 734.7 559.3 729 570C723.3 580.7 725.5 588.7 723 602C720.5 615.3 716 635 714 650C712 665 711.5 685 711 692" />
      <rect x="304" y="692" width="416" height="108" rx="38" />
    </g>
    <g class="code">
      <path d="M410 420 340 494 410 568" />
      <path d="M535 424 488 564" />
      <path d="M613 420 683 494 613 568" />
    </g>
  </svg>
  <span class="wordmark">Bake Code</span>
</span>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.72rem;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 680;
    letter-spacing: -0.035em;
  }

  svg {
    width: 2.35rem;
    height: auto;
    overflow: visible;
  }

  .hat {
    fill: none;
    stroke: var(--orange);
    stroke-width: 42;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .code {
    fill: none;
    stroke: currentColor;
    stroke-width: 42;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .inverted { color: var(--cream); }
  .compact .wordmark { display: none; }

  @media (max-width: 420px) {
    .wordmark { font-size: 1rem; }
  }
</style>
