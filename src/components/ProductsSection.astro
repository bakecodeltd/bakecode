---
import ProductFeature from './ProductFeature.astro';
import { products } from '../data/products';
---

<div id="products" class="anchor">
  <section class="made-section">
    <div class="shell made-heading reveal">
      <p class="eyebrow"><span>Built in-house</span></p>
      <h2 class="section-title">Products</h2>
      <p class="section-lede">The in-house apps that are public. KeepMyLinks and Fit were each built for a real everyday problem, and anyone can use them.</p>
    </div>
    <div class="shell product-stack">
      {products.map((product, index) => (
        <ProductFeature
          product={product}
          number={String(index + 1).padStart(2, '0')}
          reverse={index % 2 === 1}
        />
      ))}
    </div>
    <p class="shell products-next">More products are on the way — one useful release at a time.</p>
  </section>
</div>

<style>
  .anchor { scroll-margin-top: calc(var(--header-height) + 1rem); }
  .made-section { padding-block: clamp(5rem, 10vw, 10rem); background: var(--paper); }
  .made-heading { display: grid; gap: 0; align-items: start; margin-bottom: clamp(3rem, 6vw, 5rem); }
  .product-stack { display: grid; gap: clamp(2.5rem, 6vw, 6rem); }
  .products-next { margin: clamp(2.5rem, 5vw, 4rem) auto 0; color: var(--muted); font-size: 1rem; line-height: 1.7; }
</style>
