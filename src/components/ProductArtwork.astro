---
import type { ProductTheme } from '../data/products';

interface Props {
  theme: ProductTheme;
  compact?: boolean;
}

const { theme, compact = false } = Astro.props;
---

<div class:list={['artwork', `artwork--${theme}`, { compact }]} aria-hidden="true">
  {
    theme === 'links' && (
      <div class="km-window">
        <div class="km-rail">
          <span class="km-logo"></span>
          <span class="km-nav"></span>
          <span class="km-nav on"><i></i></span>
          <span class="km-nav"></span>
        </div>
        <div class="km-main">
          <div class="km-head">
            <strong>Boards</strong>
            <em>7</em>
            <span class="km-search">Search</span>
          </div>
          <div class="km-chips">
            <span>New board</span>
            <span class="on">AI</span>
            <span>Developer</span>
            <span>Kids</span>
            <span>Learning</span>
            <span>Travel</span>
          </div>
          <div class="km-status">
            <span class="km-public">Public</span>
            <span>10 cards · 108 links</span>
          </div>
          <div class="km-cols">
            <section>
              <header>AI Assistants <b>11</b></header>
              <p><i class="tone-green"></i><span>ChatGPT</span><span class="km-pills"><small>API</small><small>Cookbook</small></span></p>
              <p><i class="tone-clay"></i><span>Claude</span><span class="km-pills"><small>Docs</small><small>Console</small></span></p>
              <p><i class="tone-blue"></i><span>Gemini</span><span class="km-pills"><small>Docs</small></span></p>
              <p><i class="tone-violet"></i><span>Copilot</span><span class="km-pills"><small>Lab</small></span></p>
              <p><i class="tone-ink"></i><span>Poe</span><span class="km-pills"><small>Bots</small></span></p>
              <p><i class="tone-red"></i><span>Mistral</span><span class="km-pills"><small>Chat</small></span></p>
            </section>
            <section>
              <header>Research <b>11</b></header>
              <p><i class="tone-ink"></i><span>Perplexity</span><span class="km-pills"><small>Discover</small><small>Blog</small></span></p>
              <p><i class="tone-amber"></i><span>NotebookLM</span><span class="km-pills"><small>Help</small><small>Notes</small></span></p>
              <p><i class="tone-teal"></i><span>Elicit</span><span class="km-pills"><small>Reports</small></span></p>
              <p><i class="tone-blue"></i><span>Consensus</span><span class="km-pills"><small>Search</small></span></p>
              <p><i class="tone-sky"></i><span>Scholar</span><span class="km-pills"><small>Papers</small></span></p>
              <p><i class="tone-violet"></i><span>Connected Papers</span><span class="km-pills"><small>Graph</small></span></p>
            </section>
            <section>
              <header>Image <b>11</b><b class="km-add">+</b></header>
              <p><i class="tone-red"></i><span>Firefly</span><span class="km-pills"><small>Overview</small><small>Express</small></span></p>
              <p><i class="tone-ink"></i><span>Midjourney</span><span class="km-pills"><small>Docs</small><small>Explore</small></span></p>
              <p><i class="tone-ink"></i><span>Ideogram</span><span class="km-pills"><small>Canvas</small></span></p>
              <p><i class="tone-violet"></i><span>Leonardo</span><span class="km-pills"><small>Models</small></span></p>
              <p><i class="tone-ink"></i><span>Recraft</span><span class="km-pills"><small>Editor</small></span></p>
              <p><i class="tone-blue"></i><span>Freepik</span><span class="km-pills"><small>Stock</small></span></p>
            </section>
          </div>
        </div>
      </div>
    )
  }
  {
    theme === 'fit' && (
      <>
        <div class="fit-glow"></div>
        <div class="fit-top"><span>Fit</span><b>TODAY</b></div>
        <div class="fit-profiles"><span>You</span><span>Family</span></div>
        <div class="fit-board">
          <div class="fit-measure">
            <span>MEASUREMENT</span>
            <strong>72<span>.4</span></strong>
            <div class="fit-bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
          </div>
          <div class="fit-habits">
            <p><b></b>Move</p>
            <p><b></b>Sleep</p>
            <p><b class="open"></b>Water</p>
          </div>
        </div>
        <div class="fit-tag">you + family</div>
      </>
    )
  }
</div>

<style>
  .artwork { position: relative; min-height: clamp(24rem, 46vw, 42rem); overflow: hidden; isolation: isolate; }
  .compact { min-height: clamp(20rem, 34vw, 31rem); }

  /* KeepMyLinks — a cropped glimpse of boards, chips and saved links */
  .artwork--links { height: 100%; background: #f3efe8; color: #1d1c1a; container-type: size; }
  .km-window { display: grid; width: 100%; height: 100%; grid-template-columns: clamp(3rem, 9cqw, 4rem) minmax(0, 1fr); overflow: hidden; background: #f6f3ee; }
  .km-rail { display: flex; flex-direction: column; align-items: center; gap: clamp(0.8rem, 2.6cqw, 1.2rem); padding-top: clamp(0.95rem, 2.8cqw, 1.35rem); background: #f3efe8; border-right: 1px solid rgb(29 28 26 / 0.06); }
  .km-logo, .km-nav { width: clamp(0.95rem, 3cqw, 1.2rem); aspect-ratio: 1; border-radius: 0.32rem; }
  .km-logo { background: #c4785a; }
  .km-nav { background: rgb(29 28 26 / 0.14); }
  .km-nav.on { display: grid; place-items: center; width: clamp(1.25rem, 3.8cqw, 1.6rem); background: #edd3c4; }
  .km-nav.on i { width: 58%; aspect-ratio: 1; border-radius: 0.18rem; background: #c4785a; }
  .km-main { display: flex; flex-direction: column; height: 100%; min-width: 0; padding: clamp(0.7rem, 2.2cqw, 1.15rem) clamp(0.7rem, 2.2cqw, 1.15rem) clamp(0.7rem, 2cqw, 1.1rem); }
  .km-head, .km-status, .km-cols header { display: flex; align-items: center; gap: 0.4rem; }
  .km-head { margin-bottom: clamp(0.55rem, 1.8cqw, 0.9rem); }
  .km-head strong { font-family: var(--font-display); font-size: clamp(0.95rem, 3.3cqw, 1.45rem); font-weight: 560; letter-spacing: -0.04em; }
  .km-head em { display: grid; place-items: center; min-width: 1.15rem; height: 1.15rem; padding-inline: 0.28rem; border-radius: 10rem; background: #efe8df; color: #6d675f; font-size: 0.58rem; font-style: normal; font-weight: 750; }
  .km-search { margin-left: auto; padding: 0.28rem 0.7rem; border: 1px solid rgb(29 28 26 / 0.1); border-radius: 10rem; color: #8a847c; font-size: clamp(0.5rem, 1.6cqw, 0.68rem); }
  .km-chips { display: flex; gap: 0.35rem; margin-bottom: clamp(0.5rem, 1.6cqw, 0.8rem); overflow: hidden; mask-image: linear-gradient(90deg, #000 78%, transparent); }
  .km-chips span, .km-public { flex: none; padding: 0.28rem 0.55rem; border: 1px solid rgb(29 28 26 / 0.1); border-radius: 10rem; background: #fff; font-size: clamp(0.5rem, 1.7cqw, 0.68rem); font-weight: 700; }
  .km-chips .on { border-color: transparent; background: #e4b08e; color: #3d291f; }
  .km-status { margin-bottom: clamp(0.55rem, 1.8cqw, 0.85rem); color: #8a847c; font-size: clamp(0.5rem, 1.6cqw, 0.66rem); font-weight: 650; }
  .km-public { display: inline-flex; align-items: center; gap: 0.3rem; border-color: transparent; background: #e5f5ea; color: #217a45; }
  .km-public::before { width: 0.38rem; aspect-ratio: 1; border-radius: 50%; background: #3c9d62; content: ''; }
  .km-cols { display: grid; flex: 1; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: minmax(0, 1fr); gap: clamp(0.4rem, 1.4cqw, 0.7rem); min-height: 0; }
  .km-cols section { min-height: 100%; padding: clamp(0.55rem, 1.6cqw, 0.8rem); border: 1px solid rgb(29 28 26 / 0.08); border-radius: 0.7rem; background: #fff; box-shadow: 0 0.7rem 1.6rem rgb(29 28 26 / 0.05); transition: transform 500ms var(--ease); }
  .km-cols section:nth-child(2) { margin-top: 0.85rem; }
  .km-cols section:nth-child(3) { margin-top: 0.3rem; }
  .artwork--links:hover .km-cols section:nth-child(1) { transform: translateY(-0.45rem); }
  .artwork--links:hover .km-cols section:nth-child(2) { transform: translateY(-0.2rem); }
  .artwork--links:hover .km-cols section:nth-child(3) { transform: translateY(-0.7rem); }
  .km-cols header { margin-bottom: 0.45rem; font-size: clamp(0.58rem, 1.9cqw, 0.78rem); font-weight: 750; letter-spacing: -0.02em; }
  .km-cols header b { color: #8a847c; font-weight: 650; }
  .km-cols header .km-add { margin-left: auto; color: #1d1c1a; font-size: 0.9rem; line-height: 1; }
  .km-cols p { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; column-gap: 0.4rem; margin: 0; padding-block: clamp(0.28rem, 0.9cqh, 0.48rem); font-size: clamp(0.56rem, 1.85cqw, 0.76rem); font-weight: 680; }
  .km-cols p > span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .km-pills { display: flex; flex-wrap: wrap; grid-column: 2; gap: 0.22rem; margin-top: 0.22rem; }
  .km-cols small { flex: none; padding: 0.1rem 0.38rem; border-radius: 10rem; background: #f3efe8; color: #6f6a63; font-size: clamp(0.46rem, 1.35cqw, 0.58rem); font-weight: 700; }
  .km-cols i { flex: none; width: 0.72rem; aspect-ratio: 1; border-radius: 0.22rem; }
  .tone-green { background: #1aa37a; }
  .tone-clay { background: #cc785c; }
  .tone-blue { background: #3b6fd8; }
  .tone-violet { background: #6d5bd0; }
  .tone-ink { background: #1d1c1a; }
  .tone-red { background: #e23b32; }
  .tone-amber { background: #e0a100; }
  .tone-teal { background: #0f766e; }
  .tone-sky { background: #3d9ec9; }

  /* Fit — a quiet log of measurements and daily habits */
  .artwork--fit { background: #102033; color: #f6f1e8; }
  .fit-glow { position: absolute; top: -18%; right: -8%; width: 55%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgb(244 107 69 / 0.55), transparent 68%); }
  .fit-top { position: absolute; z-index: 3; top: 6%; right: 6%; left: 6%; display: flex; align-items: center; justify-content: space-between; font-family: var(--font-display); font-size: clamp(1.4rem, 2.6vw, 2.2rem); font-weight: 560; letter-spacing: -0.04em; }
  .fit-top b { color: #f46b45; font-size: 0.42em; font-weight: 750; letter-spacing: 0.16em; }
  .fit-profiles { position: absolute; z-index: 3; top: 18%; left: 6%; display: flex; gap: 0.55rem; }
  .fit-profiles span { padding: 0.45rem 0.85rem; border: 1px solid rgb(246 241 232 / 0.28); border-radius: 10rem; font-size: clamp(0.55rem, 0.85vw, 0.72rem); font-weight: 750; letter-spacing: 0.08em; text-transform: uppercase; }
  .fit-profiles span:first-child { border-color: transparent; background: #f6f1e8; color: #102033; }
  .fit-board { position: absolute; top: 30%; right: 6%; bottom: 12%; left: 6%; display: grid; grid-template-columns: 1.35fr 0.75fr; gap: 4%; }
  .fit-measure, .fit-habits { border: 1px solid rgb(246 241 232 / 0.16); border-radius: 0.7rem; background: rgb(246 241 232 / 0.06); }
  .fit-measure { display: flex; flex-direction: column; padding: clamp(1rem, 2.2vw, 1.8rem); }
  .fit-measure > span, .fit-habits p { font-size: clamp(0.5rem, 0.8vw, 0.68rem); font-weight: 750; letter-spacing: 0.12em; text-transform: uppercase; }
  .fit-measure strong { margin-top: 0.2rem; font-family: var(--font-display); font-size: clamp(3.2rem, 7vw, 6.4rem); font-weight: 550; letter-spacing: -0.07em; line-height: 0.85; }
  .fit-measure strong span { color: #7ddec0; }
  .fit-bars { display: flex; align-items: end; gap: 0.45rem; height: 28%; margin-top: auto; }
  .fit-bars i { flex: 1; border-radius: 0.2rem 0.2rem 0 0; background: rgb(246 241 232 / 0.28); }
  .fit-bars i:nth-child(1) { height: 38%; }
  .fit-bars i:nth-child(2) { height: 52%; }
  .fit-bars i:nth-child(3) { height: 46%; }
  .fit-bars i:nth-child(4) { height: 64%; }
  .fit-bars i:nth-child(5) { height: 58%; }
  .fit-bars i:nth-child(6) { height: 78%; }
  .fit-bars i:nth-child(7) { height: 100%; background: #f46b45; }
  .fit-habits { display: flex; flex-direction: column; justify-content: space-between; padding: clamp(1rem, 2vw, 1.6rem); transition: transform 500ms var(--ease); }
  .artwork--fit:hover .fit-habits { transform: translateY(-0.35rem); }
  .fit-habits p { display: flex; align-items: center; gap: 0.7rem; margin: 0; }
  .fit-habits b { width: 0.85rem; aspect-ratio: 1; border: 2px solid #7ddec0; border-radius: 0.2rem; background: #7ddec0; box-shadow: inset 0 0 0 2px #102033; }
  .fit-habits b.open { background: transparent; box-shadow: none; }
  .fit-tag { position: absolute; z-index: 4; right: 8%; bottom: 5%; padding: 0.5rem 0.8rem; border-radius: 10rem; background: #f4d64e; color: #102033; font-size: clamp(0.5rem, 0.8vw, 0.67rem); font-weight: 750; letter-spacing: 0.04em; transform: rotate(-3deg); }

  @media (max-width: 620px) {
    .artwork { min-height: 27rem; }
    .km-window { grid-template-columns: minmax(0, 1fr); }
    .km-rail { display: none; }
    .km-cols section:nth-child(2),
    .km-cols section:nth-child(3) { margin-top: 0; }
    .fit-board { grid-template-columns: 1fr; grid-template-rows: 1.35fr 0.7fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .km-cols section, .fit-habits { transition: none; }
  }
</style>
