---
import type { ProductTheme } from '../data/products';

interface Props {
  theme: ProductTheme;
  compact?: boolean;
}

const { theme, compact = false } = Astro.props;

type Link = [name: string, host: string, color: string, glyph: string];

const boards: { title: string; count: number; links: Link[] }[] = [
  {
    title: 'Assistants',
    count: 11,
    links: [
      ['ChatGPT', 'chatgpt.com', '#10a37f', 'C'],
      ['Claude', 'claude.ai', '#d97757', 'C'],
      ['Gemini', 'gemini.google.com', '#4f7cf5', 'G'],
      ['Perplexity', 'perplexity.ai', '#1f6f78', 'P'],
      ['Copilot', 'copilot.microsoft.com', '#7a5af8', 'C'],
      ['Mistral', 'chat.mistral.ai', '#f2742c', 'M'],
    ],
  },
  {
    title: 'Create',
    count: 9,
    links: [
      ['Midjourney', 'midjourney.com', '#2a2522', 'M'],
      ['Runway', 'runwayml.com', '#e2513a', 'R'],
      ['ElevenLabs', 'elevenlabs.io', '#3a3633', 'XI'],
      ['Suno', 'suno.com', '#f0a030', 'S'],
      ['Firefly', 'firefly.adobe.com', '#e23b32', 'F'],
      ['Ideogram', 'ideogram.ai', '#2f6fe0', 'I'],
    ],
  },
  {
    title: 'Design',
    count: 11,
    links: [
      ['Figma', 'figma.com', '#a259ff', 'F'],
      ['Framer', 'framer.com', '#0b84ff', 'F'],
      ['Penpot', 'penpot.app', '#1d1c1a', 'P'],
      ['Spline', 'spline.design', '#f15a9a', 'S'],
      ['Webflow', 'webflow.com', '#4353ff', 'W'],
      ['Recraft', 'recraft.ai', '#2a2522', 'R'],
    ],
  },
];
---

<div class:list={['artwork', `artwork--${theme}`, { compact }]} aria-hidden="true">
  {
    theme === 'links' && (
      <div class="kl-stage" data-kl-tilt>
        <div class="kl-dots"></div>
        <div class="kl-glow kl-glow--a"></div>
        <div class="kl-glow kl-glow--b"></div>
        <div class="kl-rig">
          <div class="kl-scene">
            <div class="kl-window">
              <div class="kl-bar">
                <span class="kl-lights"><i></i><i></i><i></i></span>
                <span class="kl-url"><b></b>keepmylinks.com/<em>ai-toolkit</em></span>
              </div>
              <div class="kl-body">
                <div class="kl-top">
                  <div class="kl-title">
                    <small>Boards / AI</small>
                    <strong>AI toolkit</strong>
                  </div>
                  <span class="kl-public">Public</span>
                  <span class="kl-search"><i></i>Search 108 links<kbd>⌘K</kbd></span>
                </div>
                <div class="kl-chips">
                  <span class="on">AI toolkit</span>
                  <span>Developer</span>
                  <span>Reading</span>
                  <span>Travel</span>
                  <span>Recipes</span>
                  <span>Kids</span>
                </div>
                <div class="kl-cards">
                  {boards.map((board, index) => (
                    <section class:list={['kl-card', { 'kl-card--target': index === 2 }]}>
                      <header>
                        <strong>{board.title}</strong>
                        {index === 2 ? (
                          <span class="kl-count"><span><b>{board.count}</b><b>{board.count + 1}</b></span></span>
                        ) : (
                          <span class="kl-count">{board.count}</span>
                        )}
                      </header>
                      {index === 2 && (
                        <div class="kl-row kl-row--new">
                          <div class="kl-row-inner">
                            <i class="kl-fav" style="--c: #ea4c89">D</i>
                            <span><b>Dribbble</b><small>dribbble.com/shots</small></span>
                          </div>
                        </div>
                      )}
                      {board.links.map(([name, host, color, glyph]) => (
                        <div class="kl-row">
                          <div class="kl-row-inner">
                            <i class="kl-fav" style={`--c: ${color}`}>{glyph}</i>
                            <span><b>{name}</b><small>{host}</small></span>
                          </div>
                        </div>
                      ))}
                    </section>
                  ))}
                </div>
              </div>
            </div>

            <div class="kl-float kl-toast">
              <span class="kl-check"></span>
              <span><strong>Saved to Design</strong><small>Synced to all your devices</small></span>
            </div>

            <span class="kl-orb kl-orb--1" style="--c: #10a37f">C</span>
            <span class="kl-orb kl-orb--2" style="--c: #a259ff">F</span>
            <span class="kl-orb kl-orb--3" style="--c: #e2513a">R</span>
            <span class="kl-spark kl-spark--1"></span>
            <span class="kl-spark kl-spark--2"></span>
            <span class="kl-spark kl-spark--3"></span>

            <div class="kl-fly">
              <div class="kl-pill">
                <i class="kl-fav" style="--c: #ea4c89">D</i>
                <span><b>Dribbble</b><small>dribbble.com/shots</small></span>
              </div>
              <svg class="kl-cursor" viewBox="0 0 24 24"><path d="M4 2.5 20 11l-7.2 1.9L9.4 20 4 2.5Z" /></svg>
            </div>
          </div>
        </div>
      </div>
    )
  }
  {
    theme === 'fit' && (
      <>
        <div class="fit-glow"></div>
        <div class="fit-top"><span>Fit</span><b>TODAY</b></div>
        <div class="fit-profiles"><span>You</span><span>Family</span></div>
        <div class="fit-board">
          <div class="fit-measure">
            <span>MEASUREMENT</span>
            <strong>72<span>.4</span></strong>
            <div class="fit-bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
          </div>
          <div class="fit-habits">
            <p><b></b>Move</p>
            <p><b></b>Sleep</p>
            <p><b class="open"></b>Water</p>
          </div>
        </div>
        <div class="fit-tag">you + family</div>
      </>
    )
  }
</div>

<style>
  .artwork { position: relative; min-height: clamp(24rem, 46vw, 42rem); overflow: hidden; isolation: isolate; }
  .compact { min-height: clamp(20rem, 34vw, 31rem); }

  /* KeepMyLinks — a link is dragged onto a board, saved and synced, inside a tilted 3D scene */
  .artwork--links { --loop: 9s; --clay: #e08a63; height: 100%; background: #0e0c0b; color: #1d1c1a; container-type: size; }
  .kl-stage { position: absolute; inset: 0; overflow: hidden; perspective: 1800px; background: radial-gradient(78% 72% at 40% 48%, transparent 46%, rgb(8 6 5 / 0.62) 100%), radial-gradient(46% 40% at 40% 46%, rgb(255 220 196 / 0.22), transparent 70%), radial-gradient(42% 36% at 92% 6%, rgb(244 107 69 / 0.34), transparent 64%), radial-gradient(36% 32% at 4% 100%, rgb(244 214 78 / 0.14), transparent 68%), linear-gradient(168deg, #3a2a22 0%, #1a1411 42%, #0c0a09 100%); }
  .kl-stage::before { position: absolute; right: 10%; bottom: -18%; left: 6%; height: 46%; border-radius: 50%; background: radial-gradient(ellipse at center, rgb(255 196 160 / 0.22), transparent 68%); content: ''; filter: blur(6px); pointer-events: none; }
  .kl-dots { position: absolute; inset: 0; background-image: radial-gradient(rgb(255 236 220 / 0.22) 0.7px, transparent 0.85px); background-size: 16px 16px; mask-image: radial-gradient(62% 58% at 40% 46%, #000 18%, transparent 76%); opacity: 0.7; }
  .kl-glow { position: absolute; aspect-ratio: 1; border-radius: 50%; filter: blur(48px); animation: kl-drift 14s ease-in-out infinite alternate; }
  .kl-glow--a { top: -24%; right: -6%; width: 62cqw; background: rgb(244 107 69 / 0.34); }
  .kl-glow--b { bottom: -32%; left: -16%; width: 52cqw; background: rgb(255 186 120 / 0.2); animation-delay: -7s; }

  .kl-rig { position: absolute; inset: 0; display: grid; place-items: center; transform-style: preserve-3d; transition: transform 1.4s var(--ease) 0.15s, opacity 1s var(--ease) 0.15s; }
  .kl-scene { position: relative; width: min(90cqw, 128cqh); aspect-ratio: 10 / 7; translate: 0 3cqh; container-type: inline-size; font-family: var(--font-body); transform-style: preserve-3d; transform: rotateX(calc(9deg - var(--py, 0) * 8deg)) rotateY(calc(-12deg + var(--px, 0) * 12deg)) rotateZ(1.2deg); transition: transform 700ms var(--ease); }

  .kl-window { position: absolute; top: 5cqw; left: 3cqw; width: 82cqw; height: 60cqw; overflow: hidden; border-radius: 1.6cqw; background: #fbf8f4; box-shadow: 0 0 0 1px rgb(255 255 255 / 0.12), 0 3cqw 6cqw -1cqw rgb(0 0 0 / 0.55), 0 0 14cqw rgb(232 132 92 / 0.2); }
  .kl-window::after { position: absolute; inset: 0; background: linear-gradient(105deg, transparent 35%, rgb(255 255 255 / 0.6) 48%, transparent 60%); content: ''; pointer-events: none; translate: -110% 0; animation: kl-sheen 1.8s var(--ease) 0.9s both; }
  .kl-bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: 4.4cqw; padding-inline: 1.6cqw; border-bottom: 1px solid rgb(29 28 26 / 0.07); background: #f0eae2; }
  .kl-lights { display: flex; gap: 0.6cqw; }
  .kl-lights i { width: 1cqw; aspect-ratio: 1; border-radius: 50%; background: #ff5f57; }
  .kl-lights i:nth-child(2) { background: #febc2e; }
  .kl-lights i:nth-child(3) { background: #28c840; }
  .kl-url { display: flex; align-items: center; gap: 0.6cqw; padding: 0.55cqw 2.4cqw; border-radius: 10rem; background: #fff; box-shadow: 0 0 0 1px rgb(29 28 26 / 0.06); color: #9a938a; font-size: 1.15cqw; font-weight: 600; }
  .kl-url b { width: 0.8cqw; aspect-ratio: 1; border-radius: 50%; background: #3c9d62; }
  .kl-url em { color: #1d1c1a; font-style: normal; }

  .kl-body { display: flex; flex-direction: column; height: calc(100% - 4.4cqw); padding: 2.4cqw 2.6cqw 0; }
  .kl-top { display: flex; align-items: flex-end; gap: 1.2cqw; height: 5.4cqw; margin-bottom: 1.6cqw; }
  .kl-title small { display: block; margin-bottom: 0.4cqw; color: #9a938a; font-size: 1.05cqw; font-weight: 750; letter-spacing: 0.1em; text-transform: uppercase; }
  .kl-title strong { display: block; font-family: var(--font-display); font-size: 3.4cqw; font-weight: 600; letter-spacing: -0.05em; line-height: 1; }
  .kl-public { display: inline-flex; align-items: center; gap: 0.5cqw; margin-bottom: 0.3cqw; padding: 0.45cqw 1cqw; border-radius: 10rem; background: #e3f4e8; color: #217a45; font-size: 1.1cqw; font-weight: 750; }
  .kl-public::before { width: 0.7cqw; aspect-ratio: 1; border-radius: 50%; background: #3c9d62; content: ''; animation: kl-pulse 2.4s ease-out infinite; }
  .kl-search { display: flex; align-items: center; gap: 0.8cqw; width: 22cqw; margin-left: auto; padding: 0.8cqw 1cqw; border: 1px solid rgb(29 28 26 / 0.1); border-radius: 10rem; background: #fff; color: #9a938a; font-size: 1.2cqw; font-weight: 600; }
  .kl-search i { width: 1.1cqw; aspect-ratio: 1; border: 0.22cqw solid #b0a89e; border-radius: 50%; }
  .kl-search kbd { margin-left: auto; padding: 0.1cqw 0.5cqw; border-radius: 0.4cqw; background: #f3efe8; color: #8a847c; font-family: inherit; font-size: 1cqw; }
  .kl-chips { display: flex; gap: 0.8cqw; height: 2.8cqw; margin-bottom: 1.8cqw; overflow: hidden; mask-image: linear-gradient(90deg, #000 80%, transparent); }
  .kl-chips span { display: grid; flex: none; place-items: center; padding-inline: 1.3cqw; border: 1px solid rgb(29 28 26 / 0.1); border-radius: 10rem; background: #fff; color: #5f5952; font-size: 1.2cqw; font-weight: 700; }
  .kl-chips .on { border-color: transparent; background: #1d1c1a; color: #fbf8f4; }

  .kl-cards { display: grid; flex: 1; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.6cqw; min-height: 0; }
  .kl-card { position: relative; min-height: 0; overflow: hidden; padding: 1.4cqw 1.3cqw; border: 1px solid rgb(29 28 26 / 0.07); border-bottom: 0; border-radius: 1.2cqw 1.2cqw 0 0; background: #fff; box-shadow: 0 1cqw 2.4cqw rgb(29 28 26 / 0.06); mask-image: linear-gradient(#000 75%, transparent); }
  .kl-card--target::after { position: absolute; inset: 0; border-radius: inherit; box-shadow: inset 0 0 0 0.25cqw var(--clay); content: ''; opacity: 0; animation: kl-ring var(--loop) var(--ease) 1.2s infinite both; }
  .kl-card header { display: flex; align-items: center; justify-content: space-between; height: 2.4cqw; margin-bottom: 0.8cqw; font-size: 1.55cqw; font-weight: 800; letter-spacing: -0.02em; }
  .kl-count { height: 1.9cqw; min-width: 2.8cqw; overflow: hidden; padding-inline: 0.6cqw; border-radius: 10rem; background: #f3efe8; color: #7a736b; font-size: 1.1cqw; font-weight: 750; line-height: 1.9cqw; text-align: center; }
  .kl-count > span { display: flex; flex-direction: column; animation: kl-count var(--loop) var(--ease) 1.2s infinite both; }
  .kl-count b { font-weight: inherit; }
  .kl-row-inner { display: flex; align-items: center; gap: 1cqw; padding-block: 0.75cqw; border-top: 1px solid rgb(29 28 26 / 0.05); }
  .kl-row--new { overflow: hidden; margin-inline: -0.6cqw; padding-inline: 0.6cqw; border-radius: 0.8cqw; animation: kl-insert var(--loop) var(--ease) 1.2s infinite both; }
  .kl-row--new .kl-row-inner, .kl-row--new + .kl-row .kl-row-inner { border-top-color: transparent; }
  .kl-fav { display: grid; flex: none; place-items: center; width: 2.7cqw; aspect-ratio: 1; border-radius: 0.75cqw; background: var(--c); box-shadow: inset 0 -0.25cqw 0 rgb(0 0 0 / 0.15); color: #fff; font-family: var(--font-display); font-size: 1.25cqw; font-style: normal; font-weight: 700; }
  .kl-row span, .kl-pill span { display: flex; flex-direction: column; min-width: 0; line-height: 1.3; }
  .kl-row b, .kl-pill b { overflow: hidden; font-size: 1.45cqw; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }
  .kl-row small, .kl-pill small { overflow: hidden; color: #9a938a; font-size: 1.1cqw; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }

  .kl-float, .kl-orb { position: absolute; transition: opacity 900ms var(--ease), scale 900ms var(--ease); }
  .kl-toast { bottom: 2cqw; left: -1cqw; display: flex; align-items: center; gap: 1.2cqw; padding: 1.2cqw 1.8cqw 1.2cqw 1.2cqw; border-radius: 1.4cqw; background: #1d1c1a; box-shadow: 0 2cqw 4cqw rgb(0 0 0 / 0.45); color: #fbf8f4; transform: translateZ(8cqw); animation: kl-toast var(--loop) var(--ease) 1.2s infinite both; }
  .kl-toast strong { display: block; font-size: 1.45cqw; font-weight: 750; }
  .kl-toast small { display: block; color: #b7afa5; font-size: 1.1cqw; font-weight: 600; }
  .kl-check { display: grid; place-items: center; width: 2.8cqw; aspect-ratio: 1; border-radius: 50%; background: #3c9d62; }
  .kl-check::after { width: 0.7cqw; height: 1.3cqw; border-right: 0.3cqw solid #fff; border-bottom: 0.3cqw solid #fff; content: ''; rotate: 45deg; translate: 0 -0.15cqw; }

  .kl-orb { display: grid; place-items: center; width: 4.4cqw; aspect-ratio: 1; border-radius: 1.2cqw; background: var(--c); box-shadow: 0 1.5cqw 3cqw rgb(0 0 0 / 0.4), inset 0 -0.35cqw 0 rgb(0 0 0 / 0.18); color: #fff; font-family: var(--font-display); font-size: 2cqw; font-weight: 700; transition-delay: 0.9s; animation: kl-float 8s ease-in-out infinite alternate; }
  .kl-orb--1 { top: 18cqw; left: -4cqw; transform: translateZ(12cqw) rotate(-10deg); }
  .kl-orb--2 { top: -3cqw; left: 16cqw; width: 3.4cqw; font-size: 1.5cqw; transform: translateZ(5cqw) rotate(8deg); animation-delay: -3s; }
  .kl-orb--3 { bottom: -3cqw; left: 40cqw; transform: translateZ(14cqw) rotate(12deg); animation-delay: -5s; }
  .kl-spark { position: absolute; width: 1.6cqw; aspect-ratio: 1; background: #ffd2b8; clip-path: polygon(50% 0, 60% 40%, 100% 50%, 60% 60%, 50% 100%, 40% 60%, 0 50%, 40% 40%); animation: kl-twinkle 3.2s ease-in-out infinite; }
  .kl-spark--1 { top: 1cqw; left: 6cqw; }
  .kl-spark--2 { right: 22cqw; bottom: 1cqw; width: 1.1cqw; animation-delay: -1.2s; }
  .kl-spark--3 { top: 14cqw; right: -2cqw; animation-delay: -2.1s; }

  .kl-fly { position: absolute; z-index: 5; top: 0; left: 0; animation: kl-fly var(--loop) cubic-bezier(0.45, 0, 0.25, 1) 1.2s infinite both; }
  .kl-pill { display: flex; align-items: center; gap: 1cqw; width: 21cqw; padding: 0.9cqw 1.2cqw 0.9cqw 0.9cqw; border-radius: 1cqw; background: #fff; box-shadow: 0 0 0 0.2cqw var(--clay), 0 2.4cqw 4cqw rgb(0 0 0 / 0.35); }
  .kl-cursor { position: absolute; right: -1.4cqw; bottom: -2cqw; width: 2.8cqw; fill: #1d1c1a; filter: drop-shadow(0 0.4cqw 0.5cqw rgb(0 0 0 / 0.35)); stroke: #fff; stroke-linejoin: round; stroke-width: 1.6; }

  :global(.js .reveal:not(.in-view)) .kl-rig { opacity: 0; transform: translateY(6cqh) rotateX(22deg) scale(0.94); }
  :global(.js .reveal:not(.in-view)) .kl-float,
  :global(.js .reveal:not(.in-view)) .kl-orb { opacity: 0; scale: 0.85; }
  :global(.js .reveal:not(.in-view)) .kl-stage *,
  :global(.js .reveal:not(.in-view)) .kl-window::after { animation-play-state: paused; }

  @container (max-width: 560px) {
    .kl-scene { width: 116cqw; translate: -14cqw 4cqh; }
    .kl-toast { left: 21cqw; }
  }

  @keyframes kl-fly {
    0% { opacity: 0; transform: translateZ(10cqw); translate: 30cqw -6cqw; scale: 0.7; rotate: -8deg; }
    7%, 14% { opacity: 1; transform: translateZ(10cqw); translate: 32cqw -3cqw; scale: 1.06; rotate: -6deg; }
    34% { transform: translateZ(5cqw); translate: 56cqw 24cqw; scale: 1.04; rotate: 2deg; }
    40% { opacity: 1; transform: translateZ(0); translate: 58.3cqw 27.9cqw; scale: 1; rotate: 0deg; }
    44%, 100% { opacity: 0; transform: translateZ(0); translate: 58.3cqw 27.9cqw; scale: 1; rotate: 0deg; }
  }
  @keyframes kl-insert {
    0%, 39% { max-height: 0; opacity: 0; background-color: rgb(224 138 99 / 0); }
    45% { max-height: 6cqw; opacity: 1; background-color: rgb(224 138 99 / 0.22); }
    72% { background-color: rgb(224 138 99 / 0); }
    90% { max-height: 6cqw; opacity: 1; }
    97%, 100% { max-height: 0; opacity: 0; }
  }
  @keyframes kl-count { 0%, 41% { translate: 0 0; } 45%, 92% { translate: 0 -50%; } 97%, 100% { translate: 0 0; } }
  @keyframes kl-ring { 0%, 38% { opacity: 0; } 43% { opacity: 1; } 62%, 100% { opacity: 0; } }
  @keyframes kl-toast {
    0%, 42% { opacity: 0; translate: 0 2cqw; scale: 0.94; }
    48%, 80% { opacity: 1; translate: 0 0; scale: 1; }
    86%, 100% { opacity: 0; translate: 0 -1cqw; scale: 1; }
  }
  @keyframes kl-float { to { translate: 0.8cqw -1.8cqw; } }
  @keyframes kl-drift { to { translate: 6cqw 4cqw; scale: 1.1; } }
  @keyframes kl-twinkle { 0%, 100% { opacity: 0.2; scale: 0.6; } 50% { opacity: 1; scale: 1; } }
  @keyframes kl-sheen { to { translate: 110% 0; } }
  @keyframes kl-pulse { from { box-shadow: 0 0 0 0 rgb(60 157 98 / 0.5); } to { box-shadow: 0 0 0 0.8cqw rgb(60 157 98 / 0); } }

  /* Fit — a quiet log of measurements and daily habits */
  .artwork--fit { background: #102033; color: #f6f1e8; }
  .fit-glow { position: absolute; top: -18%; right: -8%; width: 55%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgb(244 107 69 / 0.55), transparent 68%); }
  .fit-top { position: absolute; z-index: 3; top: 6%; right: 6%; left: 6%; display: flex; align-items: center; justify-content: space-between; font-family: var(--font-display); font-size: clamp(1.4rem, 2.6vw, 2.2rem); font-weight: 560; letter-spacing: -0.04em; }
  .fit-top b { color: #f46b45; font-size: 0.42em; font-weight: 750; letter-spacing: 0.16em; }
  .fit-profiles { position: absolute; z-index: 3; top: 18%; left: 6%; display: flex; gap: 0.55rem; }
  .fit-profiles span { padding: 0.45rem 0.85rem; border: 1px solid rgb(246 241 232 / 0.28); border-radius: 10rem; font-size: clamp(0.55rem, 0.85vw, 0.72rem); font-weight: 750; letter-spacing: 0.08em; text-transform: uppercase; }
  .fit-profiles span:first-child { border-color: transparent; background: #f6f1e8; color: #102033; }
  .fit-board { position: absolute; top: 30%; right: 6%; bottom: 12%; left: 6%; display: grid; grid-template-columns: 1.35fr 0.75fr; gap: 4%; }
  .fit-measure, .fit-habits { border: 1px solid rgb(246 241 232 / 0.16); border-radius: 0.7rem; background: rgb(246 241 232 / 0.06); }
  .fit-measure { display: flex; flex-direction: column; padding: clamp(1rem, 2.2vw, 1.8rem); }
  .fit-measure > span, .fit-habits p { font-size: clamp(0.5rem, 0.8vw, 0.68rem); font-weight: 750; letter-spacing: 0.12em; text-transform: uppercase; }
  .fit-measure strong { margin-top: 0.2rem; font-family: var(--font-display); font-size: clamp(3.2rem, 7vw, 6.4rem); font-weight: 550; letter-spacing: -0.07em; line-height: 0.85; }
  .fit-measure strong span { color: #7ddec0; }
  .fit-bars { display: flex; align-items: end; gap: 0.45rem; height: 28%; margin-top: auto; }
  .fit-bars i { flex: 1; border-radius: 0.2rem 0.2rem 0 0; background: rgb(246 241 232 / 0.28); }
  .fit-bars i:nth-child(1) { height: 38%; }
  .fit-bars i:nth-child(2) { height: 52%; }
