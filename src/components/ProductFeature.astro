---
import type { Product } from '../data/products';
import ArrowIcon from './ArrowIcon.astro';
import ProductArtwork from './ProductArtwork.astro';

interface Props {
  product: Product;
  number: string;
  reverse?: boolean;
  compact?: boolean;
}

const { product, number, reverse = false, compact = false } = Astro.props;
---

<article class:list={['product-feature', `product-feature--${product.theme}`, { reverse, compact, reveal: !compact }]}>
  <div class="product-art"><ProductArtwork theme={product.theme} compact={compact} /></div>
  <div class="product-copy">
    <div class="product-meta"><span>{number}</span><p>{product.category}</p></div>
    <h3>{product.name}</h3>
    <p class="description">{product.description}</p>
    {!compact && <p class="detail">{product.detail}</p>}
    <div class="product-actions">
      <span class="status"><i></i>{product.status}</span>
      {
        product.url && (
          <a href={product.url} target="_blank" rel="noreferrer">
            Visit product <ArrowIcon external />
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .product-feature { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(18rem, 0.55fr); min-height: clamp(36rem, 55vw, 49rem); border-top: 1px solid var(--line); }
  .product-feature.reverse { grid-template-columns: minmax(18rem, 0.55fr) minmax(0, 1.45fr); }
  .product-feature.reverse .product-art { order: 2; }
  .product-art { display: flex; flex-direction: column; min-width: 0; }
  .artwork { flex: 1; width: 100%; }
  .product-copy { display: flex; flex-direction: column; padding: clamp(2rem, 4.5vw, 4.5rem); background: var(--paper); }
  .product-meta { display: flex; gap: 0.75rem; align-items: center; color: var(--muted); font-size: 0.64rem; font-weight: 750; letter-spacing: 0.1em; text-transform: uppercase; }
  .product-meta span { color: var(--orange); }
  h3 { margin: auto 0 1.5rem; font-family: var(--font-display); font-size: clamp(2.5rem, 5vw, 5.4rem); font-weight: 590; letter-spacing: -0.065em; line-height: 0.92; }
  .description { max-width: 36rem; font-family: var(--font-display); font-size: clamp(1.15rem, 1.65vw, 1.45rem); font-weight: 500; letter-spacing: -0.025em; line-height: 1.35; }
  .detail { max-width: 34rem; margin-top: 1.3rem; color: var(--muted); font-size: 0.87rem; line-height: 1.7; }
  .product-actions { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: clamp(2rem, 4vw, 4rem); padding-top: 1.25rem; border-top: 1px solid var(--line); }
  .status { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--muted); font-size: 0.66rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; }
  .status i { width: 0.45rem; aspect-ratio: 1; border-radius: 50%; background: #4d9c76; box-shadow: 0 0 0 3px color-mix(in srgb, #4d9c76 18%, transparent); }
  .product-actions a { display: inline-flex; align-items: center; gap: 0.6rem; padding-bottom: 0.25rem; border-bottom: 1px solid; color: var(--ink); font-size: 0.72rem; font-weight: 750; letter-spacing: 0.05em; text-transform: uppercase; }
  .product-actions a :global(svg) { transition: transform 180ms ease; }
  .product-actions a:hover :global(svg) { transform: translate(0.15rem, -0.15rem); }

  .compact { grid-template-columns: minmax(0, 1.25fr) minmax(16rem, 0.75fr); min-height: 31rem; }
  .compact.reverse { grid-template-columns: minmax(16rem, 0.75fr) minmax(0, 1.25fr); }
  .compact .product-copy { padding: clamp(2rem, 3vw, 3.25rem); }
  .compact h3 { font-size: clamp(2.4rem, 4vw, 4.25rem); }

  @media (max-width: 820px) {
    .product-feature, .product-feature.reverse, .compact, .compact.reverse { grid-template-columns: 1fr; }
    .product-feature.reverse .product-art { order: 0; }
    .product-copy { min-height: 28rem; }
  }
</style>
