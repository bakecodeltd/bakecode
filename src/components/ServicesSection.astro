---
import ArrowIcon from './ArrowIcon.astro';

const capabilities = [
  {
    title: 'Full-stack application development',
    body: 'Modern web applications designed as coherent systems — from domain logic and data flows to the final interface.',
    tags: ['C# / .NET', 'Node.js', 'React', 'TypeScript'],
  },
  {
    title: 'Backend & API engineering',
    body: 'Clear, reliable services and integrations built around real operational needs, sensible contracts and maintainable code.',
    tags: ['ASP.NET Core', 'REST APIs', 'Integration'],
  },
  {
    title: 'Software architecture',
    body: 'Practical technical direction for new products and evolving systems, with complexity introduced only where it earns its place.',
    tags: ['System design', 'Technical strategy', 'Review'],
  },
  {
    title: 'Database design & integration',
    body: 'Data models, queries and integrations shaped for correctness, performance and the way the software will actually be used.',
    tags: ['PostgreSQL', 'MS SQL', 'Data modelling', 'Performance'],
  },
  {
    title: 'Cloud & deployment',
    body: 'Repeatable delivery, operational visibility and cloud infrastructure that keeps applications straightforward to ship and run.',
    tags: ['CI/CD', 'Cloud', 'Infrastructure'],
  },
  {
    title: 'Legacy migration',
    body: 'Migrating legacy products onto a clearer foundation, and improving how people use them by rethinking the whole path.',
    tags: ['Legacy systems', 'Migration', 'Usability'],
  },
];

const clients = [
  { name: 'UKSBS', logo: '/assets/clients/uksbs.svg' },
  { name: 'Dynamic Planner', logo: '/assets/clients/dynamic-planner.svg' },
  { name: 'Nationwide Building Society', logo: '/assets/clients/nationwide-building-society.png' },
  { name: 'Civica', logo: '/assets/clients/civica.svg' },
  { name: 'TM Group', logo: '/assets/clients/tm-group.png' },
  { name: 'Mentor Digital', logo: '/assets/clients/mentor-digital.png' },
];
---

<div id="services" class="anchor">
  <section class="doing section">
    <div class="shell">
      <div class="doing-heading reveal">
        <p class="eyebrow"><span>For clients</span></p>
        <h2 class="section-title">Services</h2>
        <p class="section-lede">Software engineering for other teams: applications, APIs, architecture and the systems around them.</p>
      </div>
    </div>
  </section>

  <section id="capabilities" class="capabilities section anchor">
    <div class="shell">
      <div class="capabilities-heading reveal">
        <p class="eyebrow"><span>Consulting</span></p>
        <h2>Where Bake Code can help</h2>
      </div>
      <div class="capability-list">
        {capabilities.map((capability, index) => (
          <article class="capability reveal">
            <span class="capability-number">{String(index + 1).padStart(2, '0')}</span>
            <h3>{capability.title}</h3>
            <p>{capability.body}</p>
            <div class="tags">{capability.tags.map((tag) => <span>{tag}</span>)}</div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="clients" class="clients section" aria-roledescription="carousel" aria-labelledby="clients-title">
    <div class="shell">
      <div class="clients-heading reveal">
        <p class="eyebrow"><span>Experience</span></p>
        <div class="clients-heading__bar">
          <h2 id="clients-title">Clients</h2>
          <div class="clients-nav">
            <button type="button" class="clients-nav__btn" data-clients="prev" aria-label="Previous clients">
              <span class="clients-nav__icon clients-nav__icon--prev"><ArrowIcon /></span>
            </button>
            <button type="button" class="clients-nav__btn" data-clients="next" aria-label="Next clients">
              <span class="clients-nav__icon"><ArrowIcon /></span>
            </button>
          </div>
        </div>
      </div>
    </div>
    <ul class="clients-track">
      {clients.map((client) => (
        <li class="client-card">
          <div class="client-logo">
            <img src={client.logo} alt="" />
          </div>
          <div class="client-meta">
            <p class="client-name">{client.name}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>
</div>

<style>
  .anchor { scroll-margin-top: calc(var(--header-height) + 1rem); }

  .doing { padding-top: clamp(3.5rem, 7vw, 6rem); padding-bottom: 0; }
  .capabilities.section { padding-top: clamp(2.25rem, 4vw, 3.5rem); }
  .doing-heading { display: grid; gap: 0; align-items: start; }
  .capabilities-heading { display: grid; grid-template-columns: 0.5fr 1.8fr; gap: 3rem; align-items: end; margin-bottom: clamp(4rem, 8vw, 7rem); }
  .capabilities-heading h2 { margin: 0; font-family: var(--font-display); font-size: clamp(2.2rem, 4vw, 3.8rem); font-weight: 550; letter-spacing: -0.045em; line-height: 1.05; }
  .capability-list { border-top: 1px solid var(--ink); }
  .capability { position: relative; display: grid; grid-template-columns: 0.22fr 0.9fr 1fr 0.7fr; gap: clamp(1rem, 3vw, 3rem); align-items: center; padding-block: clamp(2rem, 3.5vw, 3.2rem); border-bottom: 1px solid var(--line); }
  .capability-number { color: var(--orange); font-size: 0.62rem; font-weight: 750; }
  .capability h3 { margin: 0; font-family: var(--font-display); font-size: clamp(1.5rem, 2.6vw, 2.7rem); font-weight: 560; letter-spacing: -0.05em; line-height: 1; }
  .capability > p { margin: 0; color: var(--muted); font-size: 0.84rem; line-height: 1.7; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .tags span { padding: 0.38rem 0.58rem; border: 1px solid var(--line); border-radius: 2rem; color: var(--muted); font-size: 0.55rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; }

  .clients.section { padding-top: clamp(3.5rem, 6vw, 5.5rem); padding-bottom: clamp(4.25rem, 8vw, 7rem); border-top: 1px solid var(--line); }
  .clients-heading { margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem); }
  .clients-heading__bar { display: flex; align-items: flex-end; justify-content: space-between; gap: 1.5rem; }
  .clients-heading h2 { margin: 0.35rem 0 0; font-family: var(--font-display); font-size: clamp(2.4rem, 4.5vw, 4.25rem); font-weight: 550; letter-spacing: -0.05em; line-height: 1.02; }
  .clients-nav { display: flex; gap: 0.6rem; margin-bottom: 0.45rem; }
  .clients-nav__btn { display: grid; width: 3.25rem; aspect-ratio: 1; place-items: center; border: 1px solid var(--ink); border-radius: 50%; background: var(--paper); color: var(--ink); font-size: 1.15rem; cursor: pointer; transition: background 180ms ease; }
  .clients-nav__btn:hover { background: var(--orange); }
  .clients-nav__icon { display: grid; transition: transform 220ms var(--ease); }
  .clients-nav__icon--prev { transform: scaleX(-1); }
  .clients-nav__btn:hover .clients-nav__icon { transform: scale(1.22); }
  .clients-nav__btn:hover .clients-nav__icon--prev { transform: scaleX(-1) scale(1.22); }
  .clients-track { --track-pad: max(var(--gutter), calc((100% - var(--shell)) / 2 + var(--gutter))); display: flex; gap: 1.15rem; margin: 0; padding: 0.7rem var(--track-pad) 1.6rem; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--track-pad); overscroll-behavior-x: contain; list-style: none; scrollbar-width: none; }
  .clients-track::-webkit-scrollbar { display: none; }
  .client-card { position: relative; display: flex; flex: 0 0 clamp(16.25rem, 26vw, 20rem); flex-direction: column; scroll-snap-align: start; overflow: hidden; border: 1px solid var(--line); background: var(--paper); transition: transform 280ms var(--ease), border-color 180ms ease, box-shadow 280ms var(--ease); }
  .client-card::before { content: ""; position: absolute; z-index: 1; top: 0; right: 0; left: 0; height: 3px; background: var(--orange); transform: scaleX(0); transform-origin: left center; transition: transform 320ms var(--ease); }
  .client-card:hover { border-color: rgb(23 25 28 / 0.38); box-shadow: 0 1.15rem 2.4rem rgb(23 25 28 / 0.07); transform: translateY(-0.35rem); }
  .client-card:hover::before { transform: scaleX(1); }
  .client-logo { display: flex; align-items: center; justify-content: center; height: 8.75rem; margin: 0.55rem 0.55rem 0; padding: 1.2rem 1.25rem; overflow: hidden; background: var(--cream); }
  .client-logo img { width: 100%; height: 5.5rem; object-fit: contain; object-position: center; }
  .client-meta { display: flex; align-items: center; min-height: 4.6rem; padding: 0.95rem 1.15rem 1.05rem; }
  .client-name { margin: 0; font-family: var(--font-display); font-size: 1.2rem; font-weight: 550; letter-spacing: -0.04em; line-height: 1.15; text-wrap: balance; }

  @media (max-width: 900px) {
    .capabilities-heading { grid-template-columns: 1fr; }
    .capability { grid-template-columns: auto 1fr; }
    .capability > p, .capability .tags { grid-column: 2; }
  }

  @media (max-width: 650px) {
    .clients-heading__bar { align-items: center; }
    .clients-nav { margin-bottom: 0; }
    .client-card { flex-basis: min(78vw, 19rem); }
    .client-logo { height: 7.5rem; padding: 1rem 1.05rem; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('#clients');
  const track = root?.querySelector<HTMLElement>('.clients-track');
  const prev = root?.querySelector<HTMLButtonElement>('[data-clients="prev"]');
  const next = root?.querySelector<HTMLButtonElement>('[data-clients="next"]');

  if (root && track && prev && next) {
    const count = track.querySelectorAll('.client-card').length;

    for (const card of [...track.querySelectorAll<HTMLElement>('.client-card')]) {
      const clone = card.cloneNode(true) as HTMLElement;
      clone.setAttribute('aria-hidden', 'true');
      track.append(clone);
    }

    const cards = () => [...track.querySelectorAll<HTMLElement>('.client-card')];
    const pad = () => parseFloat(getComputedStyle(track).paddingLeft) || 0;
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const setWidth = () => {
      const items = cards();
      return items.length > count ? items[count].offsetLeft - items[0].offsetLeft : 0;
    };

    const destination = (index: number) => Math.max(0, cards()[index].offsetLeft - pad());

    const nearestIndex = () => cards().reduce((best, card, index) => {
      const distance = Math.abs(card.offsetLeft - (track.scrollLeft + pad()));
      return distance < best.distance ? { index, distance } : best;
    }, { index: 0, distance: Infinity }).index;

    const normalize = () => {
      const width = setWidth();
      if (width > 0 && track.scrollLeft >= width - 1) track.scrollLeft -= width;
    };

    let frame = 0;
    let animating = false;

    const animateTo = (left: number) => {
      cancelAnimationFrame(frame);
      const start = track.scrollLeft;
      const change = left - start;
      if (Math.abs(change) < 1 || motion.matches) {
        track.scrollLeft = left;
        animating = false;
        track.style.scrollSnapType = '';
        normalize();
        return;
      }

      animating = true;
      track.style.scrollSnapType = 'none';
      const started = performance.now();

      const step = (now: number) => {
        const progress = Math.min(1, (now - started) / 460);
        const eased = 1 - (1 - progress) ** 3;
        track.scrollLeft = start + change * eased;
        if (progress < 1) {
          frame = requestAnimationFrame(step);
          return;
        }
        track.scrollLeft = left;
        animating = false;
        track.style.scrollSnapType = '';
        normalize();
      };

      frame = requestAnimationFrame(step);
    };

    const go = (delta: number) => {
      const items = cards();
      const width = setWidth();
      let from = nearestIndex();

      if (delta < 0 && from === 0) {
        track.scrollLeft += width;
        from = count;
      }

      let target = from + delta;
      if (target >= items.length) {
        track.scrollLeft -= width;
        from -= count;
        target = from + delta;
      }

      const card = items[target];
      if (!card) return;
      animateTo(destination(target));
    };

    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    track.addEventListener('pointerdown', () => {
      cancelAnimationFrame(frame);
      animating = false;
      track.style.scrollSnapType = '';
    });

    if ('onscrollend' in window) {
      track.addEventListener('scrollend', () => {
        if (!animating) normalize();
      });
    }

    let timer = 0;
    let paused = false;
    let inView = false;

    const arm = () => {
      window.clearInterval(timer);
      if (!inView || paused || motion.matches || document.hidden) return;
      timer = window.setInterval(() => go(1), 4800);
    };

    const view = new IntersectionObserver(([entry]) => {
      inView = Boolean(entry?.isIntersecting);
      arm();
    }, { threshold: 0.35 });

    view.observe(root);
    root.addEventListener('mouseenter', () => { paused = true; arm(); });
    root.addEventListener('mouseleave', () => { paused = false; arm(); });
    root.addEventListener('focusin', () => { paused = true; arm(); });
    root.addEventListener('focusout', (event) => {
      if (!root.contains(event.relatedTarget as Node | null)) {
        paused = false;
        arm();
      }
    });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(frame);
        animating = false;
        track.style.scrollSnapType = '';
        normalize();
      }
      arm();
    });
    motion.addEventListener('change', arm);
  }
</script>
